{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kawaii Radio",
  "version": "0.7.0",
  "identifier": "uz.kawaii.radio.desk",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Kawaii Radio",
        "width": 800,
        "height": 450,
        "minWidth": 360,
        "minHeight": 202,
        "center": true,
        "decorations": false,
        "resizable": true,
        "transparent": true,
        "shadow": false,
        "maximizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "appimage",
      "deb"
    ],
    "publisher": "Kawaii Uz",
    "shortDescription": "Kawaii Radio — jonli J-Pop / OST / Riot radio",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": [
          "English",
          "Russian"
        ]
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "createUpdaterArtifacts": true,
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-bad",
          "gstreamer1.0-libav",
          "gstreamer1.0-pulseaudio"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFGQUIzMjQ0NzkzOUYwRDMKUldUVDhEbDVSREtycjZUNDNxdC9IUENtOHFxTTc1aFpuYWVkRTZ4NHRvNDdxSm9lMHp0eS9mUzkK",
      "endpoints": [
        "https://raw.githubusercontent.com/soka8imokenp/kawaii_radio_desktop/main/dist/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
